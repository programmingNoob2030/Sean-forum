# 1.核心基础设施(连接层)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/forum_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: YOUR_MYSQL_USERNAME
    password: YOUR_MYSQL_PASSWORD
mybatis-plus:
  # 显式指定实体扫描包，避免 MyBatis-Plus 把无关类当成 Entity
  type-aliases-package: sim.forum.entity
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl # 把 SQL 打印到控制台